{:paths ["src" "generated"]
 :deps
 {org.clojure/clojure                    {:mvn/version "1.12.6"}
  ;; The minimum, for performance: 0.20.1 compiles recursive validators and
  ;; 0.20.2 fixes a startup-time regression. tools.deps takes the newest
  ;; version any dependency asks for, so newer malli is welcome; an older one
  ;; pinned at a consumer's top level is refused when clj-xml-fo.core loads
  ;; (clj-xml-fo.impl.malli-version).
  metosin/malli                          {:mvn/version "0.20.2"}
  ;; sitoa from Clojars. serde's pom brings xml-primitives (required directly
  ;; by clj-xml-fo.core) at the same version, and txw2 for its unparser; it no
  ;; longer pulls in bootstrapped-schema, so XSOM/JAXB stay off the runtime
  ;; classpath. Only the :bootstrap alias brings them in.
  io.github.dunnage.sitoa/serde          {:mvn/version "0.1.0"}
  org.apache.xmlgraphics/fop-core        {:mvn/version "2.11"}}

 :aliases
 {;; Regenerates generated/ from bootstrap/clj_xml_fo/fop.xsd:
  ;;   clojure -X:bootstrap
  ;; The bootstrap/ path and sitoa's XSD tooling exist only under this alias.
  :bootstrap {:extra-paths ["bootstrap"]
              :extra-deps  {io.github.dunnage.sitoa/bootstrapped-schema {:mvn/version "0.1.0"}}
              :exec-fn     clj-xml-fo.bootstrap/generate!
              :exec-args   {}}

  ;; clojure -T:build jar | install | deploy   (see build.clj)
  :build     {:deps       {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "9d08b2a"}
                           slipset/deps-deploy           {:mvn/version "0.2.5"}}
              :ns-default build}

  ;; clojure -X:docs   renders every doc/*.md example to doc/examples/<id>.pdf and .png
  :docs      {:extra-paths ["test" "test-resources"]
              :extra-deps  {org.slf4j/slf4j-nop {:mvn/version "1.7.36"}}
              :exec-fn     clj-xml-fo.doc-examples/write!
              :exec-args   {}}

  ;; clojure -X:test
  :test      {:extra-paths ["test" "test-resources"]
              :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                            org.slf4j/slf4j-nop                  {:mvn/version "1.7.36"}}
              :main-opts   ["-m" "cognitect.test-runner"]
              :exec-fn     cognitect.test-runner.api/test}}}
